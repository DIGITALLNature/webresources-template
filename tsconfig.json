{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"types": ["xrm"],
		"rootDir": "./src"
	},
	"include": [
		"./src/**/*.ts"
	],
}
