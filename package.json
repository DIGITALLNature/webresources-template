{
  "name": "digitall-webresources",
  "version": "1.0.0",
  "description": "Template repository for Dynamics 365 webresources",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint",
    "fix": "pnpm run format && pnpm run lint:fix",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "build": "pnpm run check && pnpm run bundle",
    "build:prod": "pnpm run check && pnpm run bundle:prod",
    "clean": "node scripts/clean.mjs",
    "compile": "pnpm run clean && tsc --project tsconfig.json",
    "bundle": "pnpm run compile && rolldown --config rolldown.config.js",
    "bundle:prod": "pnpm run compile && rolldown --config rolldown.config.js --minify --no-sourcemap",
    "dependencyCheck": "pnpm audit --prod && pnpm outdated --compatible",
    "update": "pnpm update --latest --interactive"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DIGITALLNature/webresources-template.git"
  },
  "author": "DIGITALL Nature GmbH",
  "license": "MS-PL",
  "bugs": {
    "url": "https://github.com/DIGITALLNature/webresources-template/issues"
  },
  "homepage": "https://github.com/DIGITALLNature/webresources-template#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/xrm": "^9.0.95",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rolldown": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
